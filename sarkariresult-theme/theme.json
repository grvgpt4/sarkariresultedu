{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1120px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#0b3d5c", "name": "Primary" },
				{ "slug": "secondary", "color": "#c0392b", "name": "Secondary" },
				{ "slug": "accent", "color": "#e67e22", "name": "Accent" },
				{ "slug": "background", "color": "#ffffff", "name": "Background" },
				{ "slug": "surface", "color": "#f4f7fa", "name": "Surface" },
				{ "slug": "text", "color": "#1f2933", "name": "Text" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "System Sans",
					"slug": "system-sans"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)"
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#0a5f8c"
				}
			}
		}
	}
}
