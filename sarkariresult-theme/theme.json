{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#09090b", "name": "Primary" },
				{ "slug": "secondary", "color": "#2563eb", "name": "Accent" },
				{ "slug": "background", "color": "#fafafa", "name": "Background" },
				{ "slug": "surface", "color": "#f4f4f5", "name": "Surface" },
				{ "slug": "text", "color": "#09090b", "name": "Text" },
				{ "slug": "muted", "color": "#71717a", "name": "Muted" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Outfit\", \"Segoe UI\", sans-serif",
					"name": "Outfit",
					"slug": "outfit"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--outfit)"
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#2563eb"
				}
			}
		}
	}
}
