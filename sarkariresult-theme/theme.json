{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"palette": [
				{ "slug": "ink", "color": "#07111f", "name": "Ink" },
				{ "slug": "mint", "color": "#00c2a8", "name": "Mint" },
				{ "slug": "electric", "color": "#2f6bff", "name": "Electric" },
				{ "slug": "hot", "color": "#ff4d6d", "name": "Hot" },
				{ "slug": "background", "color": "#f3f7fb", "name": "Background" },
				{ "slug": "text", "color": "#07111f", "name": "Text" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Syne\", \"Manrope\", sans-serif",
					"name": "Syne",
					"slug": "syne"
				},
				{
					"fontFamily": "\"Manrope\", \"Segoe UI\", sans-serif",
					"name": "Manrope",
					"slug": "manrope"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)"
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#2f6bff"
				}
			}
		}
	}
}
