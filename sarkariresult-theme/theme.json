{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#061a2e", "name": "Primary" },
				{ "slug": "secondary", "color": "#dc2626", "name": "Secondary" },
				{ "slug": "accent", "color": "#0891b2", "name": "Accent" },
				{ "slug": "background", "color": "#eef3f8", "name": "Background" },
				{ "slug": "surface", "color": "#e8eef5", "name": "Surface" },
				{ "slug": "text", "color": "#15202b", "name": "Text" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Plus Jakarta Sans\", \"Segoe UI\", sans-serif",
					"name": "Plus Jakarta Sans",
					"slug": "plus-jakarta"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--plus-jakarta)"
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#0369a1"
				}
			}
		}
	}
}
